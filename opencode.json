{
  "$schema": "https://opencode.ai/config.json",
  "model": "atira/qwen3.8-flash-next",
  "small_model": "atira/qwen3.8-flash-next",
  "enabled_providers": ["atira"],
  "share": "disabled",
  "provider": {
    "atira": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Atira hosted Qwen (free)",
      "options": {"baseURL": "http://127.0.0.1:8765/qwen/v1", "apiKey": "local", "timeout": 360000},
      "models": {"qwen3.8-flash-next": {"name": "Qwen3.8-Flash-Next", "limit": {"context": 256000, "output": 16000}}}
    }
  },
  "permission": {
    "*": "allow",
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "gh *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "rm -rf*": "deny",
      "env": "deny",
      "printenv*": "deny",
      "atira token*": "deny"
    }
  }
}
